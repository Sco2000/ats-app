/* wxss */

.card-container {
    position: relative;
    width: 480rpx;
    border-radius: 16rpx;
    overflow: hidden;
}

.icon-heart {
    position: absolute;
    top: 45rpx;
    right: 45rpx;
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
}

.subtitle-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.price-button-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    white-space: nowrap;
    gap: 16rpx;
}

.price-button-row.price-only {
    justify-content: flex-start;
}

.button-container {
    display: flex;
    justify-content: flex-end;
    width: 120rpx;
}

