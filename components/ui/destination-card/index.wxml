<!-- wxml -->
<view class="card-container" style="width: {{ cardWidth }}; {{ cardContainerStyle }}">
    <app-card containerClass="br-45 box-shadow-sm {{ cardPaddingClass }} gap-3" containerStyle="{{ cardStyle }}">
        <view class="image-container">
            <osn-image src="{{ destination.image }}" mode="aspectFill" imageStyle="width: 100%; height: {{ imageHeight }}; border-radius: {{ imageRadius }};"/>
            <view class="icon-heart" catchtap="handleLikeTap">
                <view class="icon-heart__inner">
                    <block wx:if="{{ isLiked }}">
                        <osn-icon icon="heartRed" width="{{34}}" height="{{32}}"/>
                    </block>
                    <block wx:else>
                        <osn-icon icon="heart" width="{{34}}" height="{{32}}"/>
                    </block>
                </view>
            </view>
        </view>

        <view class="destination-card-body">
            <view class="destination-title">
                <app-typography size="14" weight="600" color="#1C1C1C" lineHeight="35rpx">
                    {{ destination.title }}
                </app-typography>
            </view>

            <view class="subtitle-row">
                <view class="subtitle-icon">
                    <osn-icon icon="icon" width="{{30}}" height="{{30}}"/>
                </view>
                <view class="destination-subtitle">
                    <app-typography size="14" weight="400" color="#4A5565" lineHeight="40rpx">
                        {{ destination.subtitle }}
                    </app-typography>
                </view>
            </view>
            
            <view class="price-button-row{{ !(showDetailsButton && destination.buttonLabel) ? ' price-only' : '' }}">
                <view class="destination-price">
                    <app-typography size="16" weight="700" color="#1C1C1C" lineHeight="48rpx">
                        {{ destination.price }}
                    </app-typography>
                </view>
                <view class="button-container" wx:if="{{ showDetailsButton && destination.buttonLabel }}">
                    <app-button
                        buttonClass="destination-details-button"
                        buttonStyle="height: 68rpx !important; width: 176rpx !important; padding: 0 !important; border-radius: 40rpx !important; background: #01953e !important; font-size: 28rpx !important; font-weight: 600 !important; line-height: 68rpx !important; box-shadow: none !important; letter-spacing: 0 !important;"
                        type="primary"
                        loading="{{ destination.loading }}"
                        bind:onPress="handleSubmit"
                    >
                        {{ destination.buttonLabel }}
                    </app-button>
                </view>
            </view>
            
        </view>
    </app-card>
</view>
