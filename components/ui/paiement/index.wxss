.card-form-section {
  margin-top: 40rpx;
}

.section-title {
  margin-bottom: 24rpx;
  display: block;
}

.card-input {
  width: 100%;
}

.card-row {
  display: flex;
  gap: 20rpx;
}

.expiry-input,
.cvv-input {
  flex: 1;
}

.payment-page-inner {
  padding: 42rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.summary-card {
  background: #009933;
  border-radius: 30rpx;
  padding: 32rpx;
}

.summary-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 24rpx 0;
}

.summary-body {
  display: flex;
  justify-content: space-between;
}

.secure-wrapper {
  margin-top: 58rpx;
  margin-bottom: 42rpx;
}

.secure-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.secure-description {
  margin-left: 48rpx;
}

.legal-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.pay-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.pay-button {
  width: 100%;
}
