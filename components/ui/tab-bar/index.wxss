.osn-tab-bar {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
}

.osn-tab-bar__tabs {
  display: flex;
  align-items: center;
  width: 100%;
  height: 128rpx;
  box-sizing: border-box;
  padding: 16rpx 32rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 39, 0.16);
}

.osn-tab-bar__tab {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 84rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  text-align: center;
  cursor: pointer;
  color: #009b4d;
  transition: color 0.25s, background 0.25s;
}

.osn-tab-bar__tab--active {
  flex: 1.55;
  min-width: 188rpx;
  padding: 0 28rpx;
  color: #ffffff;
  background: #009b4d;
  box-shadow: 0 8rpx 18rpx rgba(0, 155, 77, 0.28);
}

.osn-tab-bar__icon {
  width: 30rpx;
  height: 30rpx;
  /* flex: 0 0 44rpx; */
  display: block;
}

.osn-tab-bar__tab--active .osn-tab-bar__icon {
  filter: brightness(0) invert(1);
}

.osn-tab-bar__label {
  max-width: 100%;
  margin-left: 14rpx;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
