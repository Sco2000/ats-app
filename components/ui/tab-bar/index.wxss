.tab-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  z-index: 30;

  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 18rpx 42rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 64rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 46rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.tab-bar-item {
  min-width: 80rpx;
  height: 80rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  color: #01953e;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}
.tab-bar-item-active {
  padding: 0 24rpx 4rpx 24rpx;
  background: #01953e;
  color: #ffffff;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.1);
}

.tab-bar-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  position: relative;
  top: 1rpx;
}

.tab-bar-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 700;
  position: relative;
  top: -10rpx;
}