/* wxss */
.menu-tabs {
  display: block;
  overflow-x: scroll;
  overflow-y: hidden;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.menu-tabs::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.menu-tabs__item {
  display: inline-block;
  vertical-align: top;
  margin-right: 20rpx;
}

.featured-destination-list {
  width: 100%;
  height: 592rpx;
}

.featured-destination-list .menu-tabs__item {
  margin-right: 0;
}

.featured-destination-list .menu-tabs__item:first-child {
}

.grid-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.recommendation-destination-grid {
  gap: 32rpx;
}

.grid-item {
  /* margin-bottom: 20rpx; */
  box-sizing: border-box;
}

.vertical-list .menu-tabs__item {
  display: block;
  width: 100%;
  margin-bottom: 20rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.seeAll {
  display: flex;
  justify-content: space-between;
}

.bor {
  border: #fad700 2rpx solid;
}
