/* wxss */
.h-100 {
  min-height: 100%;
  height: auto;
}

.menu-tabs {


  min-width: 720rpx;
  overflow-x: scroll;
  overflow-y: hidden;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.menu-tabs::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.menu-tabs__item {
  display: inline-block;
  vertical-align: top;
  box-sizing: border-box;
}

.featured-destination-list {
  width: 100%;
  min-height: 592rpx;
}

.featured-destination-list .menu-tabs__item {
  margin-right: 24rpx;
}

.featured-destination-list .menu-tabs__item:first-child{
  margin-left: 32rpx;
}

.featured-destination-list .menu-tabs__item:last-child{
  margin-right: 32rpx;
}


.grid-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.recommendation-destination-grid {
  gap: 32rpx;
}

.grid-item {
  /* margin-bottom: 20rpx; */
  box-sizing: border-box;
  min-width: 0;
}

.vertical-list .menu-tabs__item {
  display: block;
  width: 100%;
  margin-bottom: 20rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.seeAll {
  display: flex;
  justify-content: space-between;
}

.bor {
  border: #fad700 2rpx solid;
}
