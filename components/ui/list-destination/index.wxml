<view class="h-100">
    <!-- Layout Défilement Horizontal (Scroll) -->
    <scroll-view
        wx:if="{{ layout === 'scroll' }}"
        class="menu-tabs {{ containerClass }}"
        scroll-x="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}">
        <view
            wx:if="{{ loading }}"
            class="menu-tabs__item menu-tabs__item--scroll {{index === 0 ? 'menu-tabs__item--first' : ''}} {{index === skeletonItems.length - 1 ? 'menu-tabs__item--last' : ''}}"
            wx:for="{{ skeletonItems }}"
            wx:key="*this"
            style="width: {{ cardWidth }};"
        >
            <app-destination-card-skeleton
                cardWidth="{{ cardWidth }}"
                imageHeight="{{ imageHeight }}"
                cardPaddingClass="{{ cardPaddingClass }}"
                cardStyle="{{ cardStyle }}"
                cardContainerStyle="{{ cardContainerStyle }}"
                imageRadius="{{ imageRadius }}"
                showDetailsButton="{{ showDetailsButton }}" />
        </view>
        <view
            wx:else
            class="menu-tabs__item menu-tabs__item--scroll {{index === 0 ? 'menu-tabs__item--first' : ''}} {{index === destinations.length - 1 ? 'menu-tabs__item--last' : ''}}"
            wx:for="{{ destinations }}"
            wx:key="id"
            wx:for-item="destination"
            style="width: {{ cardWidth }};"
        >
            <app-destination-card
                destination="{{ destination }}"
                cardWidth="{{ cardWidth }}"
                imageHeight="{{ imageHeight }}"
                cardPaddingClass="{{ cardPaddingClass }}"
                cardStyle="{{ cardStyle }}"
                cardContainerStyle="{{ cardContainerStyle }}"
                imageRadius="{{ imageRadius }}"
                showDetailsButton="{{ showDetailsButton }}"
                bind:toggleLike="handleToggleLike"
                bind:onCardPress="handleCardPress" />
        </view>
    </scroll-view>

    <!-- Layout Grille (Grid) -->
    <view wx:elif="{{ layout === 'grid' }}" class="grid-container {{ containerClass }}">
        <view wx:if="{{ loading }}" class="grid-item" wx:for="{{ skeletonItems }}" wx:key="*this" style="flex: 0 0 {{ computedGridItemWidth }};">
            <app-destination-card-skeleton
                cardWidth="100%"
                imageHeight="{{ imageHeight }}"
                cardPaddingClass="{{ cardPaddingClass }}"
                cardStyle="{{ cardStyle }}"
                cardContainerStyle="{{ cardContainerStyle }}"
                imageRadius="{{ imageRadius }}"
                showDetailsButton="{{ showDetailsButton }}" />
        </view>
        <view wx:else class="grid-item" wx:for="{{ destinations }}" wx:key="id" wx:for-item="destination" style="flex: 0 0 {{ computedGridItemWidth }};">
            <app-destination-card
                destination="{{ destination }}"
                cardWidth="100%"
                imageHeight="{{ imageHeight }}"
                cardPaddingClass="{{ cardPaddingClass }}"
                cardStyle="{{ cardStyle }}"
                cardContainerStyle="{{ cardContainerStyle }}"
                imageRadius="{{ imageRadius }}"
                showDetailsButton="{{ showDetailsButton }}"
                bind:toggleLike="handleToggleLike"
                bind:onCardPress="handleCardPress" />
        </view>
    </view>

    <!-- Layout Liste Verticale -->
    <view wx:else class="vertical-list">
        <view wx:if="{{ loading }}" class="menu-tabs__item" wx:for="{{ skeletonItems }}" wx:key="*this" style="width: 100%;">
            <app-destination-card-skeleton
                cardWidth="100%"
                imageHeight="{{ imageHeight }}"
                cardPaddingClass="{{ cardPaddingClass }}"
                cardStyle="{{ cardStyle }}"
                cardContainerStyle="{{ cardContainerStyle }}"
                imageRadius="{{ imageRadius }}"
                showDetailsButton="{{ showDetailsButton }}" />
        </view>
        <view wx:else class="menu-tabs__item" wx:for="{{ destinations }}" wx:key="id" wx:for-item="destination" style="width: 100%;">
            <app-destination-card
                destination="{{ destination }}"
                cardWidth="100%"
                imageHeight="{{ imageHeight }}"
                cardPaddingClass="{{ cardPaddingClass }}"
                cardStyle="{{ cardStyle }}"
                cardContainerStyle="{{ cardContainerStyle }}"
                imageRadius="{{ imageRadius }}"
                showDetailsButton="{{ showDetailsButton }}"
                bind:toggleLike="handleToggleLike"
                bind:onCardPress="handleCardPress" />
        </view>
    </view>
</view>
