<view>
    <view class="header-row">
        <app-typography size="18" weight="600" color="#1C1C1C">
            Destinations à la Une
        </app-typography>
        <view class="seeAll">
            <app-typography size="16" weight="600" color="#01953E">Voir tout</app-typography>
            <osn-icon icon="arrow" width="{{20}}" height="{{20}}" color="#01953E"/>
        </view>
    </view>
    <scroll-view class="menu-tabs" scroll-x="true" show-scrollbar="false">
        <view class="menu-tabs__item" wx:for="{{ destinations }}" wx:key="id" wx:for-item="destination">
        <app-destination-card
            destination="{{ destination }}"
            bind:onCardPress="handleCardPress" />
        </view>
    </scroll-view>
</view>