.reservation-popup__modal-container {
  position: fixed !important;
  top: auto !important;
  left: 32rpx !important;
  right: 32rpx !important;
  bottom: 32rpx !important;
  width: calc(100% - 64rpx) !important;
  height: 65vh !important;
  max-height: 65vh !important;
  border-radius: 40rpx !important;
  margin: 0 !important;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15) !important;
  overflow-y: auto !important;
  display: flex !important;
  flex-direction: column !important;
  background: #ffffff !important;
}

.reservation-popup .osn-modal-overlay {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background-color: rgba(0, 0, 0, 0.5) !important;
  z-index: 9999 !important;
}

.reservation-popup .osn-modal-container {
  position: fixed !important;
  top: auto !important;
  left: 32rpx !important;
  right: 32rpx !important;
  bottom: 32rpx !important;
  width: calc(100% - 64rpx) !important;
  height: 65vh !important;
  max-height: 65vh !important;
  border-radius: 40rpx !important;
  margin: 0 !important;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15) !important;
  transform: none !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
  background: #ffffff !important;
  z-index: 10000 !important;
}

.reservation-popup .osn-modal-body {
  flex: 1 1 auto !important;
  overflow-y: auto !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  width: 100% !important;
  padding: 0 !important;
  box-sizing: border-box !important;
}

.reservation-popup .osn-modal-body > view {
  width: 100% !important;
  max-width: 100% !important;
  align-self: stretch !important;
}

.reservation-popup .osn-modal-body .app-card {
  width: 100% !important;
  max-width: 100% !important;
  align-self: stretch !important;
}

.reservation-popup .osn-modal-body .app-button {
  width: 100% !important;
  max-width: 100% !important;
  align-self: center !important;
  text-align: center !important;
}

.reservation-popup .osn-modal-body .reservation-popup__actions {
  width: 100% !important;
  align-self: stretch !important;
}

.reservation-popup .osn-modal-body .reservation-popup__button {
  align-self: center !important;
  width: 100% !important;
  max-width: 100% !important;
  text-align: center !important;
}

.reservation-popup .osn-modal-body .reservation-popup__button--danger {
  align-self: center !important;
  width: 100% !important;
  max-width: 100% !important;
  text-align: center !important;
  margin: 0 auto !important;
}



.reservation-popup__button,
.reservation-popup__button.osn-btn-primary,
.reservation-popup__button.osn-btn-secondary {
  min-height: 96rpx !important;
  padding: 0 !important;
  border-radius: 24rpx !important;
  box-shadow: none !important;
  letter-spacing: 0 !important;
  box-sizing: border-box;
  width: 100% !important;
  max-width: 100% !important;
  align-self: center !important;
}

.reservation-popup__button--primary,
.reservation-popup__button--primary.osn-btn-primary {
  background: #009b43 !important;
  border: 0 !important;
}

.btn-primary-label {
  display: block;
  font-weight: 600;
  line-height: 22rpx;
  color: #ffffff;
}

.btn-cancel-label {
  display: block;
  font-weight: 600;
  line-height: 22rpx;
  color: #ff1f2d;
  text-align: center;
}

.reservation-popup__button--danger,
.reservation-popup__button--danger.osn-btn-secondary {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  max-width: 100% !important;
  align-self: center !important;
  margin: 0 auto !important;
  background: #ffffff !important;
  border: 2rpx solid #ff1f2d !important;
  color: #e53e3e !important;
}

.reservation-popup__modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #e5e7eb;
  flex-shrink: 0 !important;
}

.header-title {
  display: block;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 26rpx;
  color: #111111;
}

.reservation-popup__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  padding: 0;
  background: transparent;
  border: 0;
  margin-left: 12rpx;
}

.reservation-popup__close-icon {
  width: 24rpx;
  height: 24rpx;
}

.reservation-popup__scroll-content {
  width: 100%;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.reservation-popup__hero-image {
  width: 100%;
  height: auto;
  overflow: hidden;
  background: #f3f4f6;
  border-radius: 24rpx;
  border: 0;
  margin-bottom: 0;
}

.reservation-popup__hero-body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 0;
}

.reservation-popup__hero-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.dest-name {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: inherit; /* controlled by <app-typography> */
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
}

.reservation-popup__status-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 90rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #d9f9e6;
  box-sizing: border-box;
}

.reservation-popup__status-pill.done {
  background: #f2f4f7;
}

.reservation-popup__status-pill.done .badge-text {
  color: #6b7280;
}

.badge-text {
  display: block;
  font-size: inherit; /* controlled by <app-typography> */
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
}

.reservation-popup__reference-box {
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 100%;
  min-height: 80rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #f4eadb;
  box-sizing: border-box;
  margin-bottom: 0;
}

.field-label {
  display: block;
  font-size: inherit; /* controlled by <app-typography> */
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
}

.ref-value {
  display: block;
  margin-top: 6rpx;
  font-size: inherit; /* controlled by <app-typography> */
  font-weight: inherit;
  line-height: inherit;
  letter-spacing: 0.5rpx;
  color: inherit;
}

.reservation-popup__info-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  margin-top: 0;
  padding-bottom: 0;
}

.reservation-popup__info-card {
  display: flex;
  align-items: center;
  min-height: auto;
  padding: 16rpx 24rpx;
  margin-bottom: 0;
  border: 0;
  border-radius: 16rpx;
  background: #fafafa;
  box-shadow: none;
  box-sizing: border-box;
}

.reservation-popup__info-row {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 10rpx;
}

.reservation-popup__info-icon,
.reservation-popup__support-icon,
.reservation-popup__download-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.reservation-popup__info-icon--green,
.reservation-popup__support-icon--green {
  filter: brightness(0) saturate(100%) invert(40%) sepia(96%) saturate(1445%)
    hue-rotate(107deg) brightness(92%) contrast(91%);
}

.reservation-popup__download-icon--white {
  filter: brightness(0) invert(1);
}

.reservation-popup__info-text {
  flex: 1;
  min-width: 0;
}

.field-value {
  display: block;
  margin-top: 2rpx;
  font-size: inherit; /* controlled by <app-typography> */
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
}

.reservation-popup__divider {
  height: 2rpx;
  width: 100%;
  background: #f0f0f0;
  margin: 32rpx 0;
  border: 0;
}

.reservation-popup__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  width: 100%;
  margin: 0;
  padding: 0;
  border-bottom: 0;
}

.total-label {
  display: block;
  font-size: inherit; /* controlled by <app-typography> */
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
}

.total-amount {
  display: block;
  font-size: inherit; /* controlled by <app-typography> */
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  text-align: right;
}

.reservation-popup__support-card {
  display: flex !important;
  flex-direction: column !important;
  gap: 16rpx !important;
  width: 100%;
  padding: 24rpx;
  border: 0 !important;
  border-radius: 16rpx !important;
  background: #fafafa;
  box-shadow: none;
  box-sizing: border-box;
  align-self: stretch !important;
  margin-bottom: 0;
}

.help-title {
  display: block;
  font-size: inherit; /* controlled by <app-typography> */
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  margin-bottom: 10rpx;
}

.reservation-popup__support-action {
  display: flex;
  align-items: center;
  padding: 24rpx;
  width: 100%;
  border: 1rpx solid #e9eef2;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: none;
  box-sizing: border-box;
  transition:
    border-color 120ms ease,
    background-color 120ms ease;
}

.support-action__left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 10rpx;
}

.help-text {
  display: block;
  font-size: inherit; /* controlled by <app-typography> */
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
}

.reservation-popup__support-action:hover,
.reservation-popup__support-action:active,
.reservation-popup__support-action--hover,
.reservation-popup__support-action.is-focused {
  border-color: #18a84a;
  background: #ffffff;
  transform: translateY(-1rpx);
}

.reservation-popup__actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  padding: 0;
  width: 100%;
}

.reservation-popup__button,
.reservation-popup__button.osn-btn-primary,
.reservation-popup__button.osn-btn-secondary {
  min-height: 96rpx !important;
  padding: 0 !important;
  border-radius: 24rpx !important;
  box-shadow: none !important;
  letter-spacing: 0 !important;
  box-sizing: border-box;
  width: 100% !important;
  max-width: 100% !important;
  align-self: center !important;
}

.reservation-popup__button--primary,
.reservation-popup__button--primary.osn-btn-primary {
  background: #009b43 !important;
  border: 0 !important;
}

.reservation-popup__button--danger,
.reservation-popup__button--danger.osn-btn-secondary {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  max-width: 100% !important;
  align-self: center !important;
  margin: 0 auto !important;
  background: #ffffff !important;
  border: 2rpx solid #ff1f2d !important;
  color: #e53e3e !important;
}

.reservation-popup__button-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  gap: 8rpx;
}

.reservation-popup__button-inner {
  width: 100%;
  padding: 0 14rpx;
  box-sizing: border-box;
}

.btn-primary-label {
  display: block;
  font-weight: 600;
  line-height: 22rpx;
  color: #ffffff;
}

.btn-cancel-label {
  display: block;
  font-weight: 600;
  line-height: 22rpx;
  color: #ff1f2d;
  text-align: center;
}

.reservation-popup__scroll-content {
  width: 100%;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.reservation-popup__actions-primary .reservation-popup__button--primary,
.reservation-popup__actions-danger .reservation-popup__button--danger {
  width: 100%;
  max-width: 100%;
}
