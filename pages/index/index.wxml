<view class="page">
  <text class="title">Page actuelle : {{ activeTab }}</text>

  <view wx:if="{{ activeTab === 'home' }}">
    <text>Bienvenue sur Accueil</text>
  </view>

  <view wx:elif="{{ activeTab === 'explorer' }}">
    <text>Page Explorer</text>
  </view>

  <view wx:elif="{{ activeTab === 'favorites' }}">
    <text>Page Favoris</text>
  </view>

  <view wx:elif="{{ activeTab === 'reservations' }}">
    <text>Page Réservations</text>
  </view>

  <tab-bar
    tabs="{{ tabs }}"
    activeTab="{{ activeTab }}"
    bind:change="handleTabChange"
  />
</view>