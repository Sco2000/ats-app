@import "../shared-tab-page.wxss";

.favorites-page {
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.favorites-page__header {
  margin-bottom: 24rpx;
}

.favorites-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 48rpx 24rpx 80rpx;
  text-align: center;
  color: #7a8094;
}
