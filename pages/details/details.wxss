/* =============================================
   DETAILS PAGE — WeChat Mini Program
   ============================================= */

page {
  background-color: #F7F7F7;
  height: 100%;
}

/* ===== SCROLL ===== */
.page-scroll {
  width: 100%;
  height: 100vh;
  padding-top: 70rpx;
}

/* ===== HERO IMAGE ===== */
.hero-wrapper {
  width: 100%;
  padding: 28rpx 28rpx 0 28rpx;
  box-sizing: border-box;
}

.hero-container {
  width: 100%;
  height: 720rpx;
  border-radius: 40rpx;
  overflow: hidden;
  position: relative;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 36rpx;
  box-sizing: border-box;
}

/* Boutons haut */
.header-buttons {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.round-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.95);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.btn-icon {
  font-size: 36rpx;
  color: #1A1A1A;
  line-height: 1;
}

.btn-icon.liked {
  color: #E53935;
}

/* ===== CONTENU ===== */
.content-card {
  width: 100%;
  background-color: #FFFFFF;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  margin-top: 24rpx;
}

.destination-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 20rpx;
}

/* Rating */
.rating-row {
  display: flex;
  align-items: center;
  flex-direction: row;
  margin-bottom: 22rpx;
}

.stars {
  font-size: 34rpx;
  color: #F5A623;
  margin-right: 8rpx;
}

.rating-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-right: 6rpx;
}

.rating-count {
  font-size: 26rpx;
  color: #8A8A8A;
}

/* Meta (lieu & durée) */
.meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 32rpx;
}

.meta-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 36rpx;
}

.meta-icon-pin,
.meta-icon-clock {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #555555;
}

/* Séparateur */
.divider {
  width: 100%;
  height: 1rpx;
  background-color: #F0F0F0;
  margin: 28rpx 0;
}

/* Titre de section */
.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 20rpx;
}

/* Description */
.description-text {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.7;
  display: block;
  margin-bottom: 32rpx;
  white-space: normal;
  word-break: break-word;
}

/* Tag catégorie */
.category-tag {
  display: inline-flex;
  background-color: #FFF3E0;
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 8rpx;
}

.category-label {
  font-size: 26rpx;
  color: #9A7B4F;
  font-weight: 500;
}

/* ===== GALERIE PHOTOS ===== */
.gallery-wrapper {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* Ligne simple : grand format */
.gallery-row {
  width: 100%;
}

.gallery-img-full {
  width: 100%;
  height: 380rpx;
  border-radius: 24rpx;
  display: block;
}

/* Ligne double : 2 côte à côte */
.gallery-row-double {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.gallery-img-half {
  flex: 1;
  height: 280rpx;
  border-radius: 24rpx;
  min-width: 0;
}

/* Spacer bas */
.bottom-spacer {
  height: 180rpx;
}

/* ===== NAVBAR FIXE ===== */
.navbar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #FFFFFF;
  border-top: 1rpx solid #EFEFEF;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 36rpx 30rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

/* Partie gauche : label + prix */
.navbar-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.navbar-label {
  font-size: 24rpx;
  color: #9A9A9A;
  display: block;
  margin-bottom: 4rpx;
}

/* Prix sur une seule ligne */
.navbar-price-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.navbar-price {
  font-size: 46rpx;
  font-weight: 800;
  color: #1A1A1A;
  white-space: nowrap;
}

.navbar-per {
  font-size: 26rpx;
  color: #9A9A9A;
  white-space: nowrap;
  margin-left: 4rpx;
}

/* Bouton Réserver */
.btn-reserver {
  background-color: #01953E;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 24rpx;
  height: 96rpx;
  width: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
