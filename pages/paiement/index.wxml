<app-layout
  title="Paiement"
  showBack="{{true}}"
  showLogo="{{false}}"
  transparent="{{false}}"
  showTabBar="{{false}}"
>
  <scroll-view
    class="payment-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="payment-page">
      <view class="payment-summary-card">
        <app-typography
          containerClass="payment-summary-card__label"
          fontSize="24rpx"
          weight="400"
          color="rgba(255, 255, 255, 0.72)"
          lineHeight="34rpx"
        >
          Votre Réservation
        </app-typography>

        <app-typography
          containerClass="payment-summary-card__title"
          fontSize="44rpx"
          weight="700"
          color="#FFFFFF"
          lineHeight="56rpx"
        >
          {{ reservation.title }}
        </app-typography>

        <view class="payment-summary-card__divider"></view>

        <view class="payment-summary-card__meta">
          <view class="payment-summary-card__meta-item">
            <app-typography
              fontSize="25rpx"
              weight="400"
              color="rgba(255, 255, 255, 0.72)"
              lineHeight="36rpx"
            >
              Catégorie
            </app-typography>
            <app-typography
              fontSize="31rpx"
              weight="600"
              color="#FFFFFF"
              lineHeight="42rpx"
            >
              {{ reservation.category }}
            </app-typography>
          </view>

          <view class="payment-summary-card__meta-item">
            <app-typography
              fontSize="25rpx"
              weight="400"
              color="rgba(255, 255, 255, 0.72)"
              lineHeight="36rpx"
            >
              Durée
            </app-typography>
            <app-typography
              fontSize="31rpx"
              weight="600"
              color="#FFFFFF"
              lineHeight="42rpx"
            >
              {{ reservation.duration }}
            </app-typography>
          </view>
        </view>

        <view class="payment-summary-card__divider"></view>

        <view class="payment-summary-card__total">
          <app-typography
            fontSize="27rpx"
            weight="400"
            color="rgba(255, 255, 255, 0.72)"
            lineHeight="40rpx"
          >
            Montant Total
          </app-typography>
          <app-typography
            fontSize="48rpx"
            weight="700"
            color="#FFFFFF"
            lineHeight="58rpx"
            align="right"
          >
            {{ reservation.amount }}
          </app-typography>
        </view>
      </view>

      <app-typography
        containerClass="payment-section-title"
        fontSize="35rpx"
        weight="700"
        color="#1C1C1C"
        lineHeight="48rpx"
      >
      </app-typography>

      <view class="payment-secure-card">
        <view class="payment-secure-card__icon">
          <osn-icon icon="Vector" width="{{30}}" height="{{38}}" />
        </view>

        <view class="payment-secure-card__copy">
          <app-typography
            fontSize="29rpx"
            weight="700"
            color="#174EA6"
            lineHeight="40rpx"
          >
            Paiement Sécurisé
          </app-typography>
          <app-typography
            containerClass="payment-secure-card__description"
            fontSize="28rpx"
            weight="400"
            color="#0F52FF"
            lineHeight="44rpx"
          >
            Toutes les transactions sont cryptées et traitées de manière sécurisée via la super-app Max It. Vos informations de paiement ne sont jamais stockées.
          </app-typography>
        </view>
      </view>

      <view class="payment-terms">
        <view class="payment-terms__line">
          <app-typography containerClass="payment-terms__copy" fontSize="24rpx" weight="400" color="#7A8094" lineHeight="34rpx">
            En finalisant cette réservation, vous acceptez nos
          </app-typography>
        </view>

        <view class="payment-terms__line">
          <app-typography containerClass="payment-terms__link" fontSize="30rpx" weight="700" color="#fad700" lineHeight="36rpx">
            Conditions d'Utilisation
          </app-typography>
          <app-typography containerClass="payment-terms__copy" fontSize="24rpx" weight="400" color="#7A8094" lineHeight="34rpx">
            et notre
          </app-typography>
        </view>

        <view class="payment-terms__line">
          <app-typography containerClass="payment-terms__link" fontSize="30rpx" weight="700" color="#fad700" lineHeight="36rpx">
            Politique d'Annulation.
          </app-typography>
          <app-typography containerClass="payment-terms__copy" fontSize="24rpx" weight="400" color="#7A8094" lineHeight="34rpx">
            Remboursement complet
          </app-typography>
        </view>

        <view class="payment-terms__line">
          <app-typography containerClass="payment-terms__copy" fontSize="24rpx" weight="400" color="#7A8094" lineHeight="34rpx">
            disponible jusqu'à 24h avant le voyage.
          </app-typography>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="payment-footer">
    <app-button
      type="primary"
      buttonClass="payment-pay-button"
      loading="{{ isPaying }}"
      bind:onPress="handlePay"
    >
      <view class="payment-pay-button__content">
        <app-typography
          containerClass="payment-pay-button__label"
          fontSize="32rpx"
          weight="700"
          color="#FFFFFF"
          lineHeight="48rpx"
          align="center"
        >
          Payer {{ reservation.amount }}
        </app-typography>

        <osn-icon
          icon="Vector"
          width="{{24}}"
          height="{{30}}"
          containerClass="payment-pay-button__icon"
          containerStyle="padding: 0; filter: brightness(0) invert(1);"
        />
      </view>
    </app-button>
  </view>
</app-layout>
