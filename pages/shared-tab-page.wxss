.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.content {
  flex: 1;
  min-height: 0;
  height: 100%;
  box-sizing: border-box;
}

.section-card {
  padding: 32rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.section-title {
  display: block;
  margin-bottom: 12rpx;
  color: #111827;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
}

.section-text {
  display: block;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.5;
}

.padding-space{
  padding-top: 48rpx;
  padding-right: 31.98rpx;
  padding-left: 31.98rpx;
  padding-bottom: 31.98rpx;
}