page {
  width: 100%;
  height: 100%;
  background: #ffffff;
  font-family: Inter, sans-serif;
}

.destination-detail-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: #ffffff;
  color: #1c1c1c;
}

.destination-detail-page__scroll {
  width: 100%;
  height: 100vh;
}

.destination-detail-page__inner {
  padding-top: 32rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-hero-container {
  width: 100%;
  height: 840rpx;
  box-sizing: border-box;
  background: #ffffff;
  padding: 32rpx;
}

.detail-hero {
  position: relative;
  width: 100%;
  height: 776rpx;
  display: block;
  border-radius: 40rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.detail-floating-button {
  position: absolute;
  top: 32rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow:
    0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1),
    0 2rpx 8rpx rgba(0, 0, 0, 0.14);
  z-index: 2;
}

.detail-floating-button--back {
  left: 32rpx;
}

.detail-floating-button--favorite {
  right: 32rpx;
}

.detail-content {
  padding: 40rpx 40rpx 40rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.detail-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1c1c1c;
  line-height: 58rpx;
  letter-spacing: 0;
  padding: 0.88rpx 0.88rpx 0.88rpx 0rpx;
}

.detail-hero-image {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
  display: block;
}

.detail-gallery-image {
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
  display: block;
}

.detail-gallery__grid-item .detail-gallery-image {
  border-radius: 24rpx;
}

.detail-rating-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.detail-stars {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.detail-star {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.detail-star--active {
  color: #fad700;
}

.detail-star--inactive {
  color: #d0d5dd;
}

.detail-rating-score {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1c1c;
  line-height: 38rpx;
  margin-left: 14rpx;
}

.detail-rating-count {
  font-size: 28rpx;
  font-weight: 400;
  color: #667085;
  line-height: 40rpx;
  margin-left: 12rpx;
}

.detail-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 28rpx;
  margin-top: 24rpx;
}

.detail-meta-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.detail-meta-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #667085;
  line-height: 40rpx;
  display: block;
}

.detail-section {
  margin-top: 48rpx;
}

.detail-section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1c1c;
  line-height: 48rpx;
  letter-spacing: 0;
}

.detail-description {
  font-size: 34rpx;
  font-weight: 400;
  color: #667085;
  line-height: 52rpx;
  margin-top: 18rpx;
  letter-spacing: 0;
}

.detail-category-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 54rpx;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #f5eadb;
}

.detail-category-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #1c1c1c;
  line-height: 40rpx;
}

.detail-section--gallery {
  margin-top: 50rpx;
}

.detail-gallery {
  margin-top: 28rpx;
}

.detail-gallery--double {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.detail-gallery__full {
  width: 100%;
  height: 384rpx;
  display: block;
  border-radius: 28rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.detail-gallery--single .detail-gallery__full,
.detail-gallery--double .detail-gallery__full {
  height: 384rpx;
}

.detail-gallery__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 24rpx;
}

.detail-gallery__grid-item {
  width: calc((100% - 24rpx) / 2);
  height: 254rpx;
  display: block;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.detail-gallery__grid-item--full {
  width: 100%;
}

.detail-booking-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 36rpx calc(24rpx + env(safe-area-inset-bottom)) 36rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid #f2f4f7;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-booking-price {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.detail-booking-label {
  font-size: 24rpx;
  font-weight: 400;
  color: #7b889b;
  line-height: 32rpx;
  margin-bottom: 6rpx;
  display: block;
}

.detail-booking-price-line {
  display: flex;
  align-items: baseline;
  white-space: nowrap;
}

.detail-booking-amount {
  font-size: 40rpx;
  font-weight: 800;
  color: #1c1c1c;
  line-height: 48rpx;
  letter-spacing: -0.5rpx;
}

.detail-booking-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #7b889b;
  line-height: 32rpx;
  margin-left: 6rpx;
}

.detail-booking-button {
  flex-shrink: 0;
}

.detail-booking-reserve-btn {
  min-width: 220rpx;
  height: 92rpx;
  padding: 0 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #01953e;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(1, 149, 62, 0.28);
}

.detail-booking-reserve-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.destination-detail-page--empty,
.destination-detail-page--empty-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.detail-empty-card {
  width: 100%;
  padding: 48rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow:
    0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1),
    0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  text-align: center;
}

.detail-empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1c1c;
  line-height: 48rpx;
}

.detail-empty-text {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #667085;
  line-height: 40rpx;
}

.detail-empty-button {
  margin: 32rpx auto 0;
  width: 220rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: #01953e;
}

.custom-preview-overlay {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.82);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #0d0d0d;
  min-height: 100vh;
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.custom-preview-header {
  position: absolute;
  top: calc(120rpx + env(safe-area-inset-top));
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 29rpx 0 31rpx;
  z-index: 10000;
}

.custom-preview-counter {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: -2rpx;
  background: #0c0c0c;
  border-radius: 45%;
  padding: 20rpx;
}

.custom-preview-close {
  width: 72rpx;
  height: 72rpx;
  background: rgba(30, 30, 30, 0.85);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-text {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

.custom-preview-swiper {
  width: 100%;
  height: 70vh;
  max-height: calc(100vh - 240rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  flex: 0 0 auto;
  padding: 40rpx;
}

.custom-preview-item {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.custom-preview-image {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
}

.custom-preview-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 68rpx;
  height: 68rpx;
  background: rgba(30, 30, 30, 0.75);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  background: #534b47;
}

.custom-preview-arrow--left {
  left: 6rpx;
}

.custom-preview-arrow--right {
  right: 6rpx;
}

.arrow-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 301;
}

.skeleton-shimmer {
  background: linear-gradient(90deg, #f0f0f0 25%, #e6e6e6 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer-anim 1.5s infinite;
}

@keyframes shimmer-anim {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
