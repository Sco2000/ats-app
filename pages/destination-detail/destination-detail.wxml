<view class="destination-detail-page">
  <scroll-view
    class="destination-detail-page__scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="destination-detail-page__inner" style="padding-top: {{ pageTopOffset }}px;">
      <view class="detail-hero-container">
        <view class="detail-hero">
          <image
            class="detail-hero-image"
            src="{{ destination.heroImage || destination.image }}"
            mode="aspectFill"
          />

          <view class="detail-floating-button detail-floating-button--back" catchtap="handleBack">
            <app-icon
              icon="arrow-left"
              width="{{40}}"
              height="{{40}}"
              enableBg="{{false}}"
              containerStyle="padding: 0 !important;"
            />
          </view>

          <view class="detail-floating-button detail-floating-button--favorite" catchtap="handleToggleLike">
            <block wx:if="{{ isLiked }}">
              <app-icon
                icon="heartRed"
                width="{{38}}"
                height="{{36}}"
                enableBg="{{false}}"
                containerStyle="padding: 0 !important; transform: translateY(2rpx);"
              />
            </block>
            <block wx:else>
              <app-icon
                icon="heart"
                width="{{38}}"
                height="{{36}}"
                enableBg="{{false}}"
                containerStyle="padding: 0 !important; transform: translateY(2rpx);"
              />
            </block>
          </view>
        </view>
      </view>

      <view class="detail-content">
        <view class="detail-title">
          {{ destination.title || '' }}
        </view>

        <view class="detail-rating-row" wx:if="{{ destination }}">
          <view class="detail-stars">
            <text
              wx:for="{{ destination.stars }}"
              wx:key="value"
              class="detail-star {{ item.active ? 'detail-star--active' : 'detail-star--inactive' }}"
            >{{ item.icon }}</text>
          </view>
          <text class="detail-rating-score">
            {{ destination.ratingLabel }}
          </text>

          <text class="detail-rating-count">
            {{ destination.reviewLabel }}
          </text>
        </view>

        <view class="detail-meta-row" wx:if="{{ destination }}">
          <view class="detail-meta-item">
            <app-icon
              icon="localisation"
              width="{{28}}"
              height="{{28}}"
              enableBg="{{false}}"
              containerStyle="padding: 0 !important;"
            />
            <text class="detail-meta-text">
              {{ destination.subtitle }}
            </text>
          </view>

          <view class="detail-meta-item" wx:if="{{ destination.duration }}">
            <app-icon
              icon="calendrier"
              width="{{28}}"
              height="{{28}}"
              enableBg="{{false}}"
              containerStyle="padding: 0 !important;"
            />
            <text class="detail-meta-text">
              {{ destination.duration }}
            </text>
          </view>
        </view>

        <view class="detail-section" wx:if="{{ destination.description }}">
          <view class="detail-section-title">
            À Propos de Cette Expérience
          </view>

          <view class="detail-description">
            {{ destination.description }}
          </view>
        </view>

        <view class="detail-category-pill" wx:if="{{ destination.category }}">
          <text class="detail-category-text">
            Catégorie: {{ destination.category }}
          </text>
        </view>

        <view class="detail-section detail-section--gallery" wx:if="{{ destination.gallery && destination.gallery.length }}">
          <view class="detail-section-title">
            Galerie Photos
          </view>

          <view wx:if="{{ destination.galleryMode === 'single' }}" class="detail-gallery detail-gallery--single">
            <view
              class="detail-gallery__full"
              data-index="{{0}}"
              catchtap="handlePreviewGallery"
            >
              <image
                class="detail-gallery-image"
                src="{{ destination.mainGalleryImage }}"
                mode="aspectFill"
              />
            </view>
          </view>

          <view wx:elif="{{ destination.galleryMode === 'double' }}" class="detail-gallery detail-gallery--double">
            <view
              wx:for="{{ destination.gallery }}"
              wx:key="*this"
              wx:for-item="item"
              wx:for-index="index"
              class="detail-gallery__full"
              data-index="{{index}}"
              catchtap="handlePreviewGallery"
            >
              <image
                class="detail-gallery-image"
                src="{{ item }}"
                mode="aspectFill"
              />
            </view>
          </view>

          <view wx:else class="detail-gallery detail-gallery--mosaic">
            <view
              class="detail-gallery__full"
              data-index="{{0}}"
              catchtap="handlePreviewGallery"
            >
              <image
                class="detail-gallery-image"
                src="{{ destination.mainGalleryImage }}"
                mode="aspectFill"
              />
            </view>

            <view class="detail-gallery__grid">
              <view
                wx:for="{{ destination.remainingGalleryItems }}"
                wx:key="src"
                class="detail-gallery__grid-item {{ item.fullWidth ? 'detail-gallery__grid-item--full' : '' }}"
                data-index="{{item.index}}"
                catchtap="handlePreviewGallery"
              >
                <image
                  class="detail-gallery-image"
                  src="{{ item.src }}"
                  mode="aspectFill"
                />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="detail-booking-bar">
    <view class="detail-booking-price">
      <text class="detail-booking-label">
        À partir de
      </text>

      <view class="detail-booking-price-line">
        <text class="detail-booking-amount">
          {{ destination.price || '0 FCFA' }}
        </text>
        <text class="detail-booking-unit">
          /pers
        </text>
      </view>
    </view>

    <view class="detail-booking-button">
      <view
        class="detail-booking-reserve-btn"
        bindtap="handleReserve"
      >
        Réserver
      </view>
    </view>
  </view>
</view>

<!-- Fallback introuvable uniquement si aucune donnée après tentative -->
<view wx:if="{{ !hasDestination && !isLoading }}" class="destination-detail-page--empty-overlay">
  <view class="detail-empty-card">
    <view class="detail-empty-title">
      Destination introuvable
    </view>

    <view class="detail-empty-text">
      Retournez à l'accueil pour choisir une destination disponible.
    </view>

    <view class="detail-empty-button" bindtap="handleBack">
      <text style="color: #ffffff; font-weight: 700; font-size: 28rpx;">
        Retour
      </text>
    </view>
  </view>
</view>

<!-- Preview Overlay Modal -->
<view wx:if="{{ showPreview }}" class="custom-preview-overlay">
  <view class="custom-preview-header">
    <view class="custom-preview-counter">
      {{ previewIndex + 1 }} / {{ previewGallery.length }}
    </view>
    <view class="custom-preview-close" catchtap="closePreview">
      <text class="close-text">✕</text>
    </view>
  </view>
  <swiper 
    class="custom-preview-swiper"
    current="{{ previewIndex }}"
    circular="true"
    bindchange="onPreviewChange"
  >
    <swiper-item wx:for="{{ previewGallery }}" wx:key="*this">
      <image src="{{ item }}" mode="aspectFill" class="custom-preview-image" />
    </swiper-item>
  </swiper>

  <view class="custom-preview-arrow custom-preview-arrow--left" catchtap="prevPreviewImage">
    <text class="arrow-text">❮</text>
  </view>
  <view class="custom-preview-arrow custom-preview-arrow--right" catchtap="nextPreviewImage">
    <text class="arrow-text">❯</text>
  </view>
</view>
