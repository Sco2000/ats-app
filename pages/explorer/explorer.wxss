@import "../shared-tab-page.wxss";

.explorer-page {
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.explorer-page__hero {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.explorer-page__search {
  width: 100%;
}

.explorer-search-input {
  padding: 0 20rpx;
  background: #f5f7fb;
  border: 2rpx solid #ebeff4;
  border-radius: 999rpx;
}

.explorer-page__filters {
  width: 100%;
}

.explorer-page__results {
  margin: 20rpx 0 24rpx;
}

.explorer-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 48rpx 24rpx 80rpx;
  text-align: center;
  color: #7a8094;
}
