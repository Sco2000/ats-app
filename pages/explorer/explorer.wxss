@import "../shared-tab-page.wxss";



.explorer-page__hero {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.explorer-page__search {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  height: auto;
}

.explore-search-input {
  max-width: 600rpx;
  width: 100%;
}

.explore-search-input--focused {
  border: 2rpx solid #16a34a !important;
  box-shadow: 0 0 0 3rpx rgba(22, 163, 74, 0.1) !important;
}

.explorer-page__filters {
  width: 100%;
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.explorer-page__results {
  flex: 0 0 auto;
  padding: 24rpx 32rpx 16rpx 32rpx;
}

.explorer-page__list-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  box-sizing: border-box;
  padding: 0 32rpx;
}

.explorer-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  text-align: center;
  color: #7a8094;
}

.explorer-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.destination-list-head{
  padding-right: 31.98rpx;
  padding-left: 31.98rpx;
}