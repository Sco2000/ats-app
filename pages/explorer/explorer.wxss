@import "../shared-tab-page.wxss";

.explorer-page {
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

.explorer-page__hero {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.explorer-page__search {
  width: 100%;
}

.explorer-page__filters {
  width: 100%;
  margin-top: 12rpx;
}

.explorer-page__results {
  flex: 0 0 auto;
  margin: 20rpx 0 24rpx;
}

.explorer-page__list-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

.explorer-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 48rpx 24rpx 80rpx;
  text-align: center;
  color: #7a8094;
}
