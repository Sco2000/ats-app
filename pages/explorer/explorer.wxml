<app-layout
  title="Explorer les Destinations"
  showBack="{{true}}"
  logoSrc="/assets/images/logo.png"
  showLogo="{{false}}"
  transparent="{{false}}"
  showNavBorder="{{false}}"
  activeTab="{{activeTab}}"
>
  <view class="content explorer-page">
    <view class="explorer-page__hero">
      <view class="explorer-page__search">
          <app-input
            containerClass="explore-search-input"
            value="{{ query }}"
            placeholder="Rechercher une destination..."
            field-style="font-size: 28rpx;"
            placeholder-style="font-size: 28rpx; color: #9CA3AF;"
            icon="search"
            bind:input="onInput"
            bind:iconTap="onSearch"
            iconPosition="left"

        />
      </view>

      <view class="explorer-page__filters">
        <app-chip-group
          items="{{filters}}"
          activeId="{{activeFilter}}"
          bind:change="handleFilterChange"
        />
      </view>
    </view>

    <scroll-view class="explorer-page__list-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="explorer-page__results">
        <app-typography size="14" weight="500" color="#7A8094">
          {{ resultsLabel }}
        </app-typography>
      </view>

      <view wx:if="{{ visibleDestinations.length }}">
        <app-list-destination
          destinations="{{ visibleDestinations }}"
          layout="grid"
          columns="2"
          cardWidth="100%"
          imageHeight="288rpx"
          cardPaddingClass="p-2"
          cardStyle="height: 560rpx !important; border-radius: 32rpx !important; box-shadow: 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1), 0 2rpx 6rpx rgba(0, 0, 0, 0.1) !important;"
          cardContainerStyle="border-radius: 32rpx !important;"
          imageRadius="32rpx"
          showDetailsButton="{{ false }}"
          bind:toggleLike="handleDestinationLike"
          bind:onCardPress="handleCardPress"
        />
      </view>

      <view wx:else class="explorer-page__empty">
        <app-typography size="18" weight="600" color="#1C1C1C">
          Aucune destination trouvée
        </app-typography>
        <app-typography size="14" color="#7A8094">
          Essayez un autre mot-clé ou un autre filtre.
        </app-typography>
      </view>
    </scroll-view>
  </view>
</app-layout>
