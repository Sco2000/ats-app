<app-layout
  title="Mes Voyages"
  showBack="{{true}}"
  logoSrc="/assets/images/logo.png"
  showLogo="{{false}}"
  transparent="{{false}}"
  activeTab="{{activeTab}}"
>
  <scroll-view class="content voyages-page" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="voyages-page__header">
      <app-typography size="14" weight="500" color="#7A8094">
        {{ resultsLabel }}
      </app-typography>
    </view>

    <view wx:if="{{ reservations.length }}" class="voyages-page__list">
      <view wx:for="{{ reservations }}" wx:key="id" wx:for-item="reservation" class="reservation-card">
        <app-card
          containerClass="reservation-card__shell {{ reservation.showAction ? 'reservation-card__shell--with-action' : 'reservation-card__shell--compact' }}"
          containerStyle="border-radius: 32rpx !important; gap: 0 !important;"
        >
          <view class="reservation-card__body">
            <view class="reservation-card__image-wrap">
              <osn-image
                src="{{ reservation.image }}"
                mode="aspectFill"
                imageStyle="width: 100%; height: 100%; border-radius: 26rpx;"
              />
            </view>

            <view class="reservation-card__content">
              <view class="reservation-card__title-row">
                <app-typography size="14" weight="600" color="#1C1C1C" lineHeight="35rpx">
                  {{ reservation.title }}
                </app-typography>

                <view class="reservation-card__status {{ reservation.status }}">
                  <text class="reservation-card__status-text">{{ reservation.statusLabel }}</text>
                </view>
              </view>

              <view class="reservation-card__meta">
                <view class="reservation-card__meta-row">
                  <app-icon icon="Icon" width="{{16}}" height="{{16}}" />
                  <app-typography size="14" weight="400" color="#4A5565" lineHeight="40rpx">
                    {{ reservation.subtitle }}
                  </app-typography>
                </view>

                <view class="reservation-card__meta-row">
                  <app-icon icon="Icon" width="{{16}}" height="{{16}}" />
                  <app-typography size="14" color="#667085">
                    {{ reservation.dateLabel }}
                  </app-typography>
                </view>

                <view class="reservation-card__meta-row">
                  <app-icon icon="Icon" width="{{16}}" height="{{16}}" />
                  <app-typography size="14" color="#667085">
                    {{ reservation.travelersLabel }}
                  </app-typography>
                </view>
              </view>

              <view class="reservation-card__price-row">
                <app-typography size="16" weight="700" color="#0AA347">
                  {{ reservation.price }}
                </app-typography>
                <app-typography size="13" color="#667085">
                  Réf: {{ reservation.reference }}
                </app-typography>
              </view>
            </view>
          </view>

          <view wx:if="{{ reservation.showAction }}" class="reservation-card__footer">
            <view class="reservation-card__action">
              <app-typography size="14" weight="600" color="#0AA347">
                {{ reservation.actionLabel }}
              </app-typography>
              <text class="reservation-card__action-arrow">›</text>
            </view>
          </view>
        </app-card>
      </view>
    </view>

    <view wx:else class="voyages-page__empty">
      <app-typography size="18" weight="600" color="#1C1C1C">
        Aucune réservation pour le moment
      </app-typography>
      <app-typography size="14" color="#7A8094">
        Vos réservations apparaîtront ici après confirmation.
      </app-typography>
    </view>
  </scroll-view>
</app-layout>
