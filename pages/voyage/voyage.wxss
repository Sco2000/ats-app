@import "../shared-tab-page.wxss";

.voyages-page {
  width: auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-right: 32rpx;
  margin-left: 32rpx;
  background: transparent !important;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.voyages-page__header {
  margin-bottom: 22rpx;
  padding-top: 34rpx;
  padding-right: 0;
  padding-left: 0;
}

.voyages-page__list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-right: 0;
  padding-left: 0;
}

.reservation-card {
  width: 100%;
}

.reservation-card__shell {
  padding: 2rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 32rpx !important;
  background: #ffffff;
  box-shadow: none;
  overflow: hidden;
}

.reservation-card__shell--with-action {
  min-height: 365rpx;
}

.reservation-card__shell--compact {
  min-height: 0;
}

.reservation-card__body {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 22rpx;
}

.reservation-card__image-wrap {
  width: 192rpx;
  height: 192rpx;
  flex: 0 0 192rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.reservation-card__image-wrap image {
  border-radius: 32rpx;
}

.reservation-card__content {
  flex: 1;
  min-width: 0;
}

.reservation-card__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.reservation-card__status {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eaf8ef;
}

.reservation-card__status.done {
  background: #f2f4f7;
}

.reservation-card__status-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.2;
  color: #0aa347;
}

.reservation-card__status.done .reservation-card__status-text {
  color: #667085;
}

.reservation-card__meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.reservation-card__meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.reservation-card__price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 2rpx;
}

.reservation-card__footer {
  margin-top: 0;
  padding: 18rpx 22rpx;
  border-top: 2rpx solid #f3f4f6;
}

.reservation-card__action {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reservation-card__action-arrow {
  color: #0aa347;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 700;
}

.voyages-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 48rpx 0 80rpx;
  text-align: center;
  color: #7a8094;
}

.reservation-popup {
  position: fixed;
  left: 0;
  right: 0;
  top: 156rpx;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
}

.reservation-popup__panel {
  width: 100%;
  height: 100%;
  min-height: 0;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.detail-header {
  width: 100%;
  height: 112rpx;
  flex: 0 0 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  border-bottom: 2rpx solid #f0f1f3;
  background: #ffffff;
  box-sizing: border-box;
}

.detail-heading {
  color: #05070d;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.detail-close {
  width: 64rpx;
  height: 64rpx;
  position: relative;
  z-index: 2;
  flex: 0 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-close-line {
  position: absolute;
  width: 34rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #111827;
}

.detail-close-line-a {
  transform: rotate(45deg);
}

.detail-close-line-b {
  transform: rotate(-45deg);
}

.detail-scroll {
  width: 100%;
  height: 0;
  flex: 1;
  min-height: 0;
  background: #ffffff;
  overflow: hidden;
}

.detail-content {
  padding: 36rpx 32rpx 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.detail-image {
  display: block;
  width: 100%;
  height: 384rpx;
  border-radius: 24rpx;
  background: #eef2f4;
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 48rpx;
  margin-bottom: 42rpx;
}

.detail-title {
  flex: 1;
  min-width: 0;
  color: #05070d;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 58rpx;
  word-break: break-word;
}

.detail-status {
  flex: 0 0 auto;
  min-width: 104rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #d9fbe8;
  color: #0aa347;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.detail-status.done {
  background: #f3f4f7;
  color: #5f6674;
}

.detail-reference {
  padding: 32rpx;
  margin-bottom: 48rpx;
  border-radius: 24rpx;
  background: #f5e9da;
  box-sizing: border-box;
}

.detail-reference-label {
  display: block;
  color: #4b5870;
  font-size: 28rpx;
  line-height: 36rpx;
}

.detail-reference-value {
  display: block;
  margin-top: 12rpx;
  color: #05070d;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 48rpx;
  word-break: break-word;
}

.detail-info-card {
  min-height: 156rpx;
  display: flex;
  align-items: flex-start;
  padding: 34rpx;
  margin-bottom: 32rpx;
  border-radius: 24rpx;
  background: #fafbfc;
  box-sizing: border-box;
}

.detail-info-copy {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.detail-info-label {
  display: block;
  color: #34445d;
  font-size: 28rpx;
  line-height: 36rpx;
}

.detail-info-value {
  display: block;
  margin-top: 14rpx;
  color: #05070d;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 40rpx;
  word-break: break-word;
}

.detail-divider {
  height: 2rpx;
  margin: 18rpx 0 54rpx;
  background: #dfe3e8;
}

.detail-total-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 56rpx;
}

.detail-total-label {
  color: #34445d;
  font-size: 32rpx;
  line-height: 42rpx;
}

.detail-total-value {
  flex: 0 0 auto;
  color: #00963f;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: right;
  white-space: nowrap;
}

.detail-support {
  padding: 34rpx 30rpx;
  margin-bottom: 48rpx;
  border-radius: 24rpx;
  background: #fafbfc;
  box-sizing: border-box;
}

.detail-support-title {
  display: block;
  margin-bottom: 28rpx;
  color: #05070d;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.detail-support-button {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e2e6eb;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.detail-support-button-active {
  border-color: #00a64f;
}

.detail-support-icon {
  width: 40rpx;
  color: #00a64f;
  font-size: 36rpx;
  line-height: 40rpx;
  text-align: center;
}

.detail-support-text {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  color: #05070d;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.detail-actions {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.detail-action-button {
  width: 100%;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  margin: 0 0 28rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.detail-action-button--last {
  margin-bottom: 0;
}

.detail-primary {
  border: 2rpx solid #00963f;
  background: #00963f;
  color: #ffffff;
}

.detail-danger {
  border: 4rpx solid #ff2d2d;
  background: #ffffff;
  color: #ff2d2d;
}

.detail-download {
  margin-right: 16rpx;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
}
