@import "../shared-tab-page.wxss";

.reservation-details-page {
  position: relative;
  min-height: 100vh;
  padding: 0;
  overflow: hidden;
  background: #000000;
  color: #111111;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

.reservation-details-page .osn-layout,
.reservation-details-page .osn-layout__content {
  background-color: #000000 !important;
}

