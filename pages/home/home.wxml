<app-layout
  title="Page d'Accueil"
  showBack="{{false}}"
  logoSrc="/assets/images/logo.png"
  showLogo="{{true}}"
  transparent="{{false}}"
  activeTab="{{activeTab}}"
>
  <scroll-view class="content d-flex flex-column" show-scrollbar="{{false}}">
    <view class="h-300rpx d-flex flex-column gap-4">
      <view>
        <app-typography color="black" line-height="1.4" weight="700" size="32">
          Bonjour👋
        </app-typography>
        <app-typography color="black" line-height="1.4" size="24">
          Explorons le Sénégal
        </app-typography>
      </view>
      <view class=" h-50">
        <app-input
          placeholder="Où voulez-vous allez?"
          icon="search"
          bind:input="onSearch"
          bind:iconTap="onIconTap"
          containerClass="h-100 border fs-0 p-1 br-25 inp"
          iconPosition= "left"
          height="50"
          width="50"
        />
      </view>
    </view>
    <view class=" h-300rpx d-flex border-bottom flex-column justify-content-center gap-3">
        <app-typography size="18" weight="600" color="black">
          Destinations populaire
        </app-typography>
        <app-chip-group
          items="{{filters}}"
          activeId="{{activeFilter}}"
          bind:change="handleFilterChange"
        />
    </view>
    <view class="d-flex flex-column gap-6">
      <view class="d-flex flex-column gap-3 mt-3">
        <view class="d-flex justify-content-between align-items-center mb-2">
          <app-typography size="18" weight="600" color="black">
            Destinations à la Une
          </app-typography>
          <view class="d-flex align-items-center">
            <app-typography size="14" weight="600" color="#01953E">
              voir tout
            </app-typography>
            <app-icon icon="arrow" width="{{20}}" height="{{20}}" color="#01953E"/>
          </view>
        </view>
          <app-list-destination
            destinations="{{ destinations }}"
            layout="scroll"
            cardWidth="500rpx"
            imageHeight="300rpx"
            showDetailsButton="{{ true }}"
            bind:toggleLike="handleDestinationLike"
            bind:onCardPress="handleCardPress" />
      </view>
      <view class="d-flex flex-column gap-3">
          <app-typography size="18" weight="600" color="black">
            Recommandations
          </app-typography>
          <app-list-destination
          destinations="{{ destinations }}"
          layout="grid"
          cardWidth="500rpx"
          imageHeight="300rpx"
          showDetailsButton="{{ false }}"
          bind:toggleLike="handleDestinationLike"
          bind:onCardPress="handleCardPress" />
      </view>
    </view>
  </scroll-view>
</app-layout>