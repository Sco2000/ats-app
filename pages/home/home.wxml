<app-layout
  title="Page d'Accueil"
  showBack="{{false}}"
  logoSrc="/assets/images/logo.png"
  showLogo="{{true}}"
  transparent="{{false}}"
  activeTab="{{activeTab}}"
>
  <scroll-view class="content home d-flex flex-column" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="greetings-container padding-space d-flex flex-column">
      <view class="greetings-container__content d-flex flex-column">
          <view class="home-greeting">
            Bonjour 👋
          </view>
          <view class="home-subtitle">
            Explorons le <text class="home-subtitle__highlight">Sénégal</text> !
          </view>
      </view>
        <app-input
        containerClass="search-input mt-4"
        value="{{ query }}"
        placeholder=" Où voulez-vous allez ?"
        field-style="font-size: 28rpx;"
        placeholder-style="font-size: 28rpx; color: #9CA3AF;"
        icon="search"
        bind:input="onInput"
        bind:iconTap="onSearch"
        iconPosition="left"/>
    </view>
    <view class="chip-container d-flex flex-column">
        <view class="home-section-title destination-list-head">Destinations Populaires</view>
        <app-chip-group
          items="{{filters}}"
          activeId="{{activeFilter}}"
          bind:change="handleFilterChange"
        />
    </view>
    <view class="destination-list-container d-flex flex-column">
      <view class="destination-list-head d-flex justify-content-between">
        <view class="home-section-title">Destinations à la Une</view>
        <view class="d-flex align-items-center">
          <app-typography  size="14" weight="600" color="#01953E" bindtap="handleShowAll">
            voir tout
          </app-typography>
          <app-icon icon="arrow" width="{{20}}" height="{{20}}" color="#01953E"/>
        </view>
      </view>
      <view class="destination-list-body">
        <app-list-destination
          destinations="{{ destinations }}"
          layout="scroll"
          cardWidth="479.98rpx"
          imageHeight="287.98rpx"
          cardPaddingClass="card-padding"
          cardContainerStyle="border-radius: 32rpx !important; box-shadow: 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1), 0 2rpx 6rpx rgba(0, 0, 0, 0.1) !important; border-top: none;"
          containerClass="featured-destination-list"
          showDetailsButton="{{ true }}"
          bind:toggleLike="handleDestinationLike"
          bind:onCardPress="handleCardPress" />
      </view>
    </view>
    <view class="recomandation-list-container d-flex flex-column">
        <view class="destination-list-head home-section-title">Recommandations</view>
        <view class="recomandation-list-body">
          <app-list-destination
          destinations="{{ destinations }}"
          layout="grid"
          cardWidth="100%"
          imageHeight="288rpx"
          cardPaddingClass="p-2"
          cardStyle=""
          cardContainerStyle="border-radius: 32rpx !important; box-shadow: 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1), 0 2rpx 6rpx rgba(0, 0, 0, 0.1) !important;"
          imageRadius="32rpx"
          showDetailsButton="{{ false }}"
          bind:toggleLike="handleDestinationLike"
          bind:onCardPress="handleCardPress" />
        </view>
    </view>
  </scroll-view>
</app-layout>
